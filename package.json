{
  "name": "tauri-ext-scratch",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "rolldown -c",
    "build:turbowarp": "rolldown -c && npx prettier --config turbowarp/.prettierrc --parser acorn output/extension.js > output/extension.formatted.js",
    "start": "bun run build && bunx http-server ./output -p 8080 --cors",
    "watch": "rolldown -c --watch",
    "serve": "http-server ./output -p 8080 --cors -c-1",
    "dev": "concurrently -k -n build,serve -c blue,green \"bun run watch\" \"bun run serve\"",
    "lint": "eslint ./src",
    "lint:type": "tsc --noEmit -p ./tsconfig.json",
    "fix": "eslint ./src --fix",
    "format": "prettier ./src -c -w",
    "lint:format": "prettier ./src -c"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@turbowarp/types": "^0.0.12",
    "concurrently": "^9.1.0",
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "typescript-eslint": "^8.19.1",
    "http-server": "^14.1.1",
    "prettier": "^3.4.2",
    "rolldown": "^1.2.7"
  },
  "peerDependencies": {
    "typescript": "^7"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-os": "^2.3.2"
  }
}